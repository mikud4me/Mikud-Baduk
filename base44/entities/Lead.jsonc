{
  "name": "Lead",
  "type": "object",
  "properties": {
    "fullName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "idNumber": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "birthDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4 \u05de\u05dc\u05d0"
    },
    "age": {
      "type": "number",
      "description": "\u05d2\u05d9\u05dc \u05de\u05d7\u05d5\u05e9\u05d1"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "emailVerified": {
      "type": "boolean",
      "default": false,
      "description": "\u05d0\u05d9\u05de\u05d5\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "maritalStatus": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "divorced",
        "widowed"
      ],
      "description": "\u05de\u05e6\u05d1 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9"
    },
    "childrenUnder18": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "first_home",
        "improvement",
        "contractor",
        "any_purpose"
      ],
      "description": "\u05de\u05d8\u05e8\u05ea \u05d4\u05de\u05e9\u05db\u05e0\u05ea\u05d0"
    },
    "propertyPrice": {
      "type": "number",
      "description": "\u05e9\u05d5\u05d5\u05d9 \u05d4\u05e0\u05db\u05e1"
    },
    "propertyStatus": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e0\u05db\u05e1"
    },
    "equity": {
      "type": "number",
      "description": "\u05d4\u05d5\u05df \u05e2\u05e6\u05de\u05d9"
    },
    "netIncome": {
      "type": "number",
      "description": "\u05d4\u05db\u05e0\u05e1\u05d4 \u05e0\u05d8\u05d5"
    },
    "partnerNetIncome": {
      "type": "number",
      "description": "\u05d4\u05db\u05e0\u05e1\u05ea \u05d1\u05df/\u05d1\u05ea \u05d6\u05d5\u05d2"
    },
    "monthlyDebts": {
      "type": "number",
      "description": "\u05d7\u05d5\u05d1\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd"
    },
    "monthlyOverdraft": {
      "type": "number",
      "default": 0,
      "description": "\u05e9\u05db\u05d9\u05e8\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9\u05d9\u05ea"
    },
    "loanDuration": {
      "type": "number",
      "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05dc\u05d5\u05d5\u05d0\u05d4"
    },
    "employmentStatusA": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9"
    },
    "employmentSeniority": {
      "type": "number",
      "description": "\u05d5\u05ea\u05e7 \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d1\u05e9\u05e0\u05d9\u05dd"
    },
    "creditHistory": {
      "type": "string",
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d0\u05e9\u05e8\u05d0\u05d9"
    },
    "additionalIncomeType": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05db\u05e0\u05e1\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea"
    },
    "additionalIncomeAmount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05db\u05e0\u05e1\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea"
    },
    "additionalIncomeSources": {
      "type": "array",
      "description": "\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05db\u05e0\u05e1\u05d4 \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05de\u05e4\u05d5\u05e8\u05d8\u05d9\u05dd",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "rent",
              "maternity",
              "reserve_duty",
              "child_allowance",
              "pension",
              "second_job",
              "other"
            ]
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "partnerFullName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "partnerIdNumber": {
      "type": "string",
      "description": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "partnerBirthDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4 \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "partnerAge": {
      "type": "number",
      "description": "\u05d2\u05d9\u05dc \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "partnerEmploymentStatus": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9 \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "partnerEmploymentSeniority": {
      "type": "number",
      "description": "\u05d5\u05ea\u05e7 \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4 \u05dc\u05d5\u05d5\u05d4 \u05d1' \u05d1\u05e9\u05e0\u05d9\u05dd"
    },
    "partnerCreditHistory": {
      "type": "string",
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d0\u05e9\u05e8\u05d0\u05d9 \u05dc\u05d5\u05d5\u05d4 \u05d1'"
    },
    "loanAmount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05de\u05e9\u05db\u05e0\u05ea\u05d0 \u05de\u05d7\u05d5\u05e9\u05d1"
    },
    "ltv": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05de\u05d9\u05de\u05d5\u05df"
    },
    "score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05ea\u05db\u05e0\u05d5\u05ea"
    },
    "aiAnalysis": {
      "type": "string",
      "description": "\u05e0\u05d9\u05ea\u05d5\u05d7 AI"
    },
    "isPurchased": {
      "type": "boolean",
      "default": false,
      "description": "\u05e8\u05db\u05e9 \u05d3\u05d5\u05d7 \u05de\u05dc\u05d0"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in_process",
        "approved",
        "closed"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05d9\u05d3"
    }
  },
  "required": [
    "fullName",
    "phone",
    "email",
    "birthDate"
  ]
}