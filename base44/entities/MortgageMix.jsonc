{
  "name": "MortgageMix",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05de\u05d4\u05d9\u05dc"
    },
    "total_amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05e9\u05db\u05e0\u05ea\u05d0 \u05d4\u05db\u05d5\u05dc\u05dc"
    },
    "loan_period_years": {
      "type": "number",
      "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05dc\u05d5\u05d5\u05d0\u05d4 \u05d1\u05e9\u05e0\u05d9\u05dd"
    },
    "tracks": {
      "type": "array",
      "description": "\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05de\u05e9\u05db\u05e0\u05ea\u05d0",
      "items": {
        "type": "object",
        "properties": {
          "track_type": {
            "type": "string",
            "enum": [
              "prime",
              "fixed",
              "variable_5",
              "variable_every_5",
              "eligibility",
              "cpi_fixed",
              "cpi_variable"
            ],
            "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e1\u05dc\u05d5\u05dc"
          },
          "amount": {
            "type": "number",
            "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05e1\u05dc\u05d5\u05dc"
          },
          "interest_rate": {
            "type": "number",
            "description": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e8\u05d9\u05d1\u05d9\u05ea"
          },
          "period_years": {
            "type": "number",
            "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d1\u05e9\u05e0\u05d9\u05dd"
          }
        }
      }
    },
    "monthly_payment": {
      "type": "number",
      "description": "\u05d4\u05d7\u05d6\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05de\u05e9\u05d5\u05e2\u05e8"
    },
    "total_interest": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05e8\u05d9\u05d1\u05d9\u05ea \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "total_payment": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "\u05e8\u05de\u05ea \u05e1\u05d9\u05db\u05d5\u05df"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "total_amount",
    "loan_period_years",
    "tracks"
  ]
}