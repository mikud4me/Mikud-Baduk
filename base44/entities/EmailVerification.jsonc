{
  "name": "EmailVerification",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "codeHash": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "lastSentAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "codeHash",
    "expiresAt"
  ]
}